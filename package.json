{
  "name": "@hxym18/pwa-kit",
  "version": "0.5.0",
  "description": "PWA 接入 SDK：安装状态判定（core）+ 浏览器适配（web）+ React 绑定（react）+ 配置驱动 Service Worker 模板（sw）",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/everythingIsZero/pwa-kit.git"
  },
  "files": [
    "src",
    "README.md",
    "CHANGELOG.md"
  ],
  "exports": {
    ".": {
      "types": "./src/core/index.d.ts",
      "import": "./src/core/index.mjs",
      "default": "./src/core/index.mjs"
    },
    "./web": {
      "types": "./src/web/index.d.ts",
      "import": "./src/web/index.mjs",
      "default": "./src/web/index.mjs"
    },
    "./react": {
      "types": "./src/react/index.d.ts",
      "import": "./src/react/index.mjs",
      "default": "./src/react/index.mjs"
    },
    "./ui": {
      "types": "./src/ui/index.d.ts",
      "import": "./src/ui/index.mjs",
      "default": "./src/ui/index.mjs"
    },
    "./sw": {
      "types": "./src/sw/index.d.ts",
      "import": "./src/sw/index.mjs",
      "default": "./src/sw/index.mjs"
    },
    "./manifest": {
      "types": "./src/manifest/index.d.ts",
      "import": "./src/manifest/index.mjs",
      "default": "./src/manifest/index.mjs"
    },
    "./next": {
      "types": "./src/next/index.d.ts",
      "import": "./src/next/index.mjs",
      "default": "./src/next/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "web": [
        "src/web/index.d.ts"
      ],
      "react": [
        "src/react/index.d.ts"
      ],
      "ui": [
        "src/ui/index.d.ts"
      ],
      "sw": [
        "src/sw/index.d.ts"
      ],
      "manifest": [
        "src/manifest/index.d.ts"
      ],
      "next": [
        "src/next/index.d.ts"
      ]
    }
  },
  "scripts": {
    "test": "node --test 'test/**/*.test.mjs'"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "hxym18": {
    "contracts": {
      "sensitive-prefixes": "1+262b9b7c",
      "cache-policy": "1+f9681c71",
      "contracts": "1+2ca48235"
    }
  },
  "devDependencies": {
    "jsdom": "^30.1.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  }
}
